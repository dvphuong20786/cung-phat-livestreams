{
    "name": "tiktok-live-monitor",
    "private": true,
    "packageManager": "pnpm@11.25.0",
    "scripts": {
        "dev": "concurrently --kill-others -n server,web -c magenta,cyan \"tsx apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
        "build": "pnpm -r build",
        "test": "vitest run",
        "lint": "pnpm -r lint",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "concurrently": "^9.1.0",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vitest": "^2.1.8"
    }
}
